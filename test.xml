<scene version="2.0.0">
    <integrator type="path" />

    <sensor type="thinlens" id="Camera-camera">
        <string name="fov_axis" value="smaller"/>
        <float name="focus_distance" value=".045"/>
        <float name="aperture_radius" value=".0002"/>
        <float name="fov" value="74.0"/>
        <transform name="to_world">
            <lookat target="0, 0, 0" origin="0, 0, .125" up="0, 1, 0"/>
        </transform>

        <sampler type="independent">
            <integer name="sample_count" value="256"/>
        </sampler>

        <film type="hdrfilm" id="film">
            <integer name="width" value="8000"/>
            <integer name="height" value="8000"/>
            <string name="pixel_format" value="rgb"/>
            <integer name="crop_offset_y" value="400"/>
            <integer name="crop_offset_x" value="2200"/>
            <integer name="crop_height" value="2240"/>
            <integer name="crop_width" value="3600"/>
            <rfilter type="gaussian"/>
        </film>
    </sensor>
    <bsdf type="twosided" id="object_bsdf">
        <bsdf type="roughconductor">
            <string name="distribution" value="ggx"/>
            <texture type="bitmap" name="alpha">
                <string name="filename" value="mitsuba.roughness.rgbe"/>
            </texture>
            <spectrum name="eta" filename="test.eta.spd"/>
            <spectrum name="k" filename="test.k.spd"/>
        </bsdf>
    </bsdf>

    <shape type="ply">
        <string name="filename" value="mitsuba.ply"/>
        <transform name="to_world">
            <scale value="1"/>
            <translate x="0" y="0" z="0"/>
        </transform>
        <ref id="object_bsdf"/>
    </shape>

    <emitter type="envmap" id="Area_002-light">
        <string name="filename" value="mitsuba.rgbe"/>
        <float name="scale" value="1"/>
        <transform name="to_world">
            <rotate value="-.7, 0, .7" angle="-90"/>
        </transform>
    </emitter>

</scene>
